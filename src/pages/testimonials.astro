---
import Layout from '../layouts/Layout.astro';
import TestimonialLightbox from '../components/TestimonialLightbox.astro';
import { testimonials } from '../data/testimonials';

const items = testimonials;

const title = 'Testimonials — Growth Now Media';
const description =
	'Hear from aesthetic and wellness operators using the Growth Now Method™ to fill their calendars, lift revenue, and remove the guesswork.';
---

<Layout title={title} description={description}>
	<div class="bg-[#010130]">

		{/* HERO */}
		<section class="relative overflow-hidden px-6 pb-16 pt-32 md:px-12 md:pt-40">
			<div class="orb orb-1" aria-hidden="true"></div>
			<div class="grid-overlay" aria-hidden="true"></div>

			<div class="relative z-10 mx-auto max-w-4xl text-center">
				<p class="reveal mb-5 inline-block bg-gradient-to-r from-brand-magenta to-brand-pink bg-clip-text text-xs font-semibold uppercase tracking-[3px] text-transparent">
					Client testimonials
				</p>

				<h1 class="reveal font-display text-[clamp(36px,5.5vw,72px)] font-bold leading-[1.05] tracking-tight text-white [transition-delay:150ms]">
					Hear it from the operators.
				</h1>

				<p class="reveal mx-auto mt-6 max-w-2xl text-base leading-[1.7] text-white/60 md:text-lg [transition-delay:300ms]">
					Real owners using the Growth Now Method™ to book more appointments, lift revenue, and grow without the guesswork.
				</p>

				<div class="reveal mt-10 [transition-delay:450ms]">
					<a
						href="/contact"
						class="inline-flex w-full items-center justify-center rounded-full bg-brand-primary px-8 py-3.5 font-display text-[15px] font-semibold text-white shadow-[0_0_32px_rgba(138,26,255,0.35)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-brand-secondary hover:shadow-[0_8px_40px_rgba(138,26,255,0.5)] sm:w-auto"
					>
						Book a Demo
					</a>
				</div>
			</div>
		</section>

		{/* TESTIMONIAL GRID — all visible, no load-more gate */}
		<section class="mx-auto max-w-6xl px-6 pb-24 md:px-12">
			<div class="reveal-stagger grid grid-cols-1 justify-items-center gap-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{items.map((t, i) => (
					<button
						type="button"
						class="testimonial-card group w-full max-w-xs cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-4 focus-visible:ring-offset-[#010130] rounded-2xl"
						data-testimonial-trigger
						data-testimonial-index={i}
						aria-label={t.name ? `Play testimonial from ${t.name}` : `Play client testimonial ${i + 1}`}
					>
						<div class="relative aspect-[9/16] overflow-hidden rounded-2xl bg-gradient-to-br from-brand-primary/15 via-brand-secondary/10 to-transparent shadow-[0_4px_20px_rgba(0,0,0,0.25)] transition-all duration-300 motion-safe:group-hover:-translate-y-2 motion-safe:group-hover:scale-[1.05] group-hover:shadow-[0_20px_60px_rgba(138, 26, 255,0.4)]">
							<img
								src={t.thumbnailUrl}
								alt={t.name ? `${t.name}${t.title ? ', ' + t.title : ''}` : 'Client video testimonial'}
								loading="lazy"
								class="h-full w-full object-contain"
							/>
							<span
								class="pointer-events-none absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-white/40 shadow-[0_4px_16px_rgba(0,0,0,0.3)] transition-all duration-300 group-hover:bg-white motion-safe:group-hover:scale-[1.15] sm:h-[72px] sm:w-[72px]"
								aria-hidden="true"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-7 w-7 text-brand-secondary">
									<polygon points="6 4 20 12 6 20 6 4" />
								</svg>
							</span>
						</div>

						{(t.name || t.title || t.location) && (
							<div class="mt-4 text-center">
								{t.name && <p class="font-display text-sm font-semibold text-white">{t.name}</p>}
								{t.title && <p class="mt-0.5 text-xs text-white/60">{t.title}</p>}
								{t.location && <p class="mt-0.5 text-xs text-white/40">{t.location}</p>}
							</div>
						)}
					</button>
				))}
			</div>
		</section>

		{/* CLOSING CTA */}
		<section class="px-6 pb-28 md:px-12">
			<div class="reveal mx-auto max-w-3xl rounded-3xl border border-white/10 bg-gradient-to-br from-brand-primary/15 via-brand-secondary/5 to-transparent p-10 text-center shadow-[0_20px_80px_rgba(138,26,255,0.18)] md:p-14">
				<h2 class="font-display text-[clamp(28px,3.5vw,44px)] font-bold leading-[1.1] tracking-tight text-white">
					Want results like these?
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-base leading-[1.65] text-white/65">
					We'll show you exactly how the Growth Now Method™ would work for your business — bookings, revenue, retention, all of it.
				</p>
				<div class="mt-8">
					<a
						href="/contact"
						class="inline-flex w-full items-center justify-center rounded-full bg-brand-primary px-8 py-3.5 font-display text-[15px] font-semibold text-white shadow-[0_0_32px_rgba(138,26,255,0.35)] transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-brand-secondary hover:shadow-[0_8px_40px_rgba(138,26,255,0.5)] sm:w-auto"
					>
						Book a Demo
					</a>
				</div>
			</div>
		</section>
	</div>

	<TestimonialLightbox testimonials={items} />
</Layout>
