---
// Shared closing CTA. Founder framing, never attributed to an individual name.
// Button uses the site-wide booking link (/contact). Supporting line uses the
// binary day-choice style consistent with the rest of the site.
---

<section class="px-6 py-24 text-center md:px-12 md:py-32">
	<div class="reveal mx-auto max-w-3xl">
		<h2 class="font-display text-[clamp(36px,5vw,64px)] font-bold leading-[1.1] tracking-tight text-white">
			Book a strategy session with our founders
		</h2>
		<p class="mx-auto mt-6 max-w-xl text-base leading-[1.7] text-white/65 md:text-lg">
			Tell us the day that works, this week or next. We will build the plan around your
			calendar.
		</p>
		<div class="mt-10">
			<a
				href="/contact"
				class="cs-cta-pulse inline-flex w-full items-center justify-center rounded-full bg-brand-primary px-10 py-4 font-display text-base font-semibold text-white transition-all duration-300 ease-out hover:scale-105 hover:bg-brand-secondary sm:w-auto"
			>
				Book a Strategy Call
			</a>
		</div>
		<div class="mt-5">
			<a
				href="/testimonials"
				class="inline-flex items-center gap-1.5 font-display text-sm font-semibold text-white/70 underline decoration-white/20 underline-offset-4 transition-colors hover:text-white"
			>
				Watch client video testimonials
				<span aria-hidden="true">→</span>
			</a>
		</div>
		<p class="mt-8 text-sm text-white/50">
			Trusted by 500+ aesthetic and wellness businesses across the US
		</p>
	</div>
</section>

<style>
	.cs-cta-pulse {
		animation: cs-cta-cyan-pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}

	@keyframes cs-cta-cyan-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(15, 255, 255, 0.35), 0 0 28px rgba(138, 26, 255, 0.35);
		}
		50% {
			box-shadow: 0 0 0 12px rgba(15, 255, 255, 0), 0 0 48px rgba(15, 255, 255, 0.45);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cs-cta-pulse {
			animation: none;
		}
	}
</style>
